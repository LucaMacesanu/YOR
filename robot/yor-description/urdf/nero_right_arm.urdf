<?xml version="1.0" encoding="utf-8"?>
<!--
  nero_right_arm.urdf - Right Nero arm, 7 DOF.

  Derived from ../nero-welded-base-and-lift.mjcf, the authoritative description for this
  robot. Corrected 2026-10-02.

  Verified against that MJCF: base transform 0.0000 deg, every joint rotation within
  0.0001 deg, joint limits identical. The left/right base pair is mirror-symmetric about
  the x-z plane to 0.0000 deg.

  Corrections applied:
    - base rpy was '-1.892547 -1.570785 0.321751' (89.9994 deg from the MJCF).
      The old value carried a comment claiming it matched MJCF euler '-1.5708 0 4.7124', which
      is not what the MJCF holds; it was verified against an older revision.
    - joint7 rpy was '1.5708 0.0 -1.5708'. The MJCF stores euler (intrinsic xyz, MuJoCo's
      eulerseq default) while URDF rpy is extrinsic xyz, so identical numbers denote
      rotations 120 deg apart. The value here is converted, not copied.
    - mesh paths were 'package://nero_description/meshes/...', a ROS package that does
      not exist in this repo. Rebased to ../assets_nero/ with filename case corrected
      to match disk (link1.STL -> Link1.STL); Linux is case-sensitive, so the old refs
      failed even where the package resolved.

  Visual/collision geometry was absent from this file (it was inertia-only, so the
  right arm rendered as nothing). Copied from nero_left_arm.urdf: the MJCF references
  the identical mesh set for both arms (base_link, link1-7) under the same link names.

  Joint limits and effort come from the AgileX SDK, not from the MJCF:
    - limits are the vendor joint_limits defaults in pyAgxArm docs/nero/nero_api.md.
      Note joint4 is [-1.012291, 2.146755]; the MJCF previously had [0, 2.14], which
      clipped 58 deg of real travel off its lower end.
    - effort="16" is the MIT torque input range for firmware 1.11+ (all joints
      +-16 N.m; firmware <=1.10 is 24 N.m on j1-2, 18 on j3-4, 8 on j5-7). These arms
      are firmware >=1.12, per the v112 frame set in nerolib nero_interface.cpp:438.
      The previous effort="100" was a placeholder with no basis.

  Rated payload is 3.0 kg per arm (AgileX), reach 580 mm from the J1 axis - this model
  measures 599 mm there, within 3 percent.

  KNOWN GAP: published arm weight is 4.8 kg; this model totals 3.9801 kg. The ~0.8 kg
  gap is unexplained - possibly gripper/flange hardware or cabling not modelled. No
  per-link mass data is published, so the inertias are left as-is.
-->
<robot name="nero_right_arm">
  <link name="dummy_link" />
  <joint name="base_to_dummy" type="fixed">
    <parent link="dummy_link" />
    <child link="base_link" />
    <origin xyz="-0.005 0.125 0.0575" rpy="-1.5708 0 0" />
  </joint>
  <link name="base_link">
    <inertial>
      <origin xyz="-0.00963615 0.00016787 0.0448601" rpy="0 0 0" />
      <mass value="0.77" />
      <inertia ixx="0.0006669" ixy="0" ixz="0" iyy="0.00054501" iyz="0" izz="0.00051509" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../assets_nero/base_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../assets_nero/base_link.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="joint1" type="revolute">
    <origin xyz="0.0 0.0 0.138" rpy="0.0 0.0 0.0" />
    <parent link="base_link" />
    <child link="link1" />
    <axis xyz="0 0 1" />
    <limit lower="-2.705261" upper="2.705261" effort="16" velocity="5" />
  </joint>
  <link name="link1">
    <inertial>
      <origin xyz="-0.00077 -0.00006 -0.00686" rpy="0 0 0" />
      <mass value="0.77" />
      <inertia ixx="0.0006669" ixy="0" ixz="0" iyy="0.00054501" iyz="0" izz="0.00051509" />
