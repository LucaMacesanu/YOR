<mujoco model="yor-full-agx">
  <!-- GENERATED from yor-full.mjcf by make_agx_variant.py (stock AgileX grippers); edit that file.
       YOR, full robot: swerve base + lift + two 7-DoF AgileX Nero arms.
       Built from nero-welded-base-and-lift.mjcf (correct Nero arms, vendor joint
       limits, +-16 N.m command ceiling, tuned lift, no gravity compensation) with the
       4 swerve modules and the CAD inertials for base/lift grafted in from robot.mjcf.
       All prim names are free of '.' so the model imports into USD / Isaac Sim. -->
  <compiler angle="radian" meshdir="assets_nero"/>
  <option integrator="implicitfast" cone="elliptic" impratio="10" gravity="0 0 -9.81" timestep="0.005" />
  
  <default>
    <default class="robot">
      <default class="motor">
        <joint />
        <motor />
      </default>
      <default class="steering_joint">
        <position kp="10" kv="1" inheritrange="1" />
        <joint frictionloss="0.001" range="-3.14159 3.14159" />
      </default>
      <default class="drive_joint">
        <velocity kv="1" />
        <joint frictionloss="0.001" />
      </default>
      <default class="wheel">
        <!-- condim 4 adds friction opposing rotation about the contact normal -->
        <geom type="mesh" condim="4" contype="0" conaffinity="1" priority="1" group="3"
          solref="0.005 1" friction="1.2 0.005 0.005" />
      </default>
      <default class="visual">
        <geom material="visualgeom" type="mesh" contype="0" conaffinity="0" group="2" density="0"/>
      </default>
      <default class="collision">
        <geom type="capsule" condim="3" contype="0" conaffinity="1" priority="1" group="3" solref="0.005 1"
          friction="1 0.01 0.01" />
      </default>
      <!-- Add other defaults from original if needed -->
    </default>

    <default class="nero">
      <joint frictionloss="0.3" armature="0.005" />
      <!-- forcerange = the documented MIT-mode torque COMMAND range, not a verified
           mechanical limit. AgileX pyAgxArm docs/nero/nero_api.md gives +-16 N.m for
           all joints on firmware 1.11+ (and 24/18/8 N.m by joint group on <=1.10).
           These arms are firmware >=1.12: nerolib/src/nero_interface.cpp:438 drives
           the v112 frame set {0x155,0x156,0x157,0x170}, and 0x170 for joint7 is a
           v112 marker. The previous -100 100 was a placeholder with no basis.

           CAVEAT: 16 N.m cannot be the motors' mechanical ceiling. At the arm's own
           rated 3.0 kg payload, static holding torque exceeds 16 N.m over ~59% of the
           reachable workspace (peak 26 N.m), so the arm could not achieve its rating
           if 16 were the hard limit. Read this as what MIT mode lets you COMMAND. The
           true stall torque is unpublished - ask AgileX before sizing payloads. -->
      <position inheritrange="1" forcerange="-16 16" />
      <default class="collision_gripper">
        <geom type="mesh" group="3" friction="2 0.005 0.0001" density="100" />
      </default>
    </default>

    <default class="telescope">
      <!-- range: the real lift travels 0 to 1.2 m (was 0 to 0.208, from robot.mjcf). -->
      <joint type="slide" axis="0 0 1" damping="50" stiffness="0.02" armature="0.01" range="0 1.2" frictionloss="1.5"/>
      <general ctrlrange="0 0.416" gainprm="150" biasprm="0 -100 -10" forcerange="-56 56"/>
    </default>
    <!-- BEGIN AGX GRIPPER (defaults): generated by robot/yor-description/make_agx_variant.py - do not hand-edit. -->
    <default class="agx_gripper">
      <joint type="slide" axis="0 0 1" range="0 0.035" damping="2" armature="0.001" frictionloss="0.01"/>
      <position kp="400" dampratio="1" forcerange="-20 20" inheritrange="1"/>
      <default class="agx_gripper_visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2" density="0" material="gray_mat"/>
      </default>
      <default class="agx_gripper_collision">
        <geom group="3" friction="2 0.005 0.0001" condim="4" density="0"/>
      </default>
    </default>
    <!-- END AGX GRIPPER -->
    <!-- BEGIN HEAD (defaults): generated by output/head/build_head.py - do not hand-edit. -->
    <default class="head">
      <joint type="hinge" damping="0.6" frictionloss="0.052" armature="0.01"/>
      <position kp="20" kv="1" forcerange="-2.9 2.9" inheritrange="1"/>
      <default class="head_visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2" density="0" rgba="0.3 0.3 0.3 1"/>
      </default>
      <default class="head_collision">
        <geom type="mesh" contype="0" conaffinity="1" group="3" density="0"/>
      </default>
    </default>
    <!-- END HEAD -->
  </default>

  <asset>
    <material name="gray_mat" rgba="0.59 0.59 0.59 1" />
    <material name="light_medium_gray_mat" rgba="0.85 0.85 0.85 1" />
    <material name="base_material" rgba="1 0 0 1" />
    <material name="Lift_Middle_material" rgba="0.9 0.9 0.9 1" />
    <material name="base_profile_short_material" rgba="0.701961 0.701961 0.701961 1" />
    <material name="Part_2_material" rgba="0.615686 0.811765 0.929412 1" />
    <material name="MK4_Colson_Hub_4_X_1_5_material" rgba="0.666667 0.698039 0.768627 1" />
    
    <!-- Base/Lift meshes (assuming they are in assets_nero or need to be copied/referenced) -->
    <!-- We should probably copy base/lift meshes to assets_nero too or reference them relative? 
         The generated file is in cone-e-description, assets_nero is subdir. 
         Original meshes/base_profile_short.stl etc. might need to be copied. 
         For now assume they are available or we use exact filenames if copied. -->
    
    <!-- Nero arm meshes -->
    <mesh name="base_link" file="base_link.STL" />
    <mesh name="link1" file="Link1.STL" />
    <mesh name="link2" file="Link2.STL" />
    <mesh name="link3" file="Link3.STL" />
    <mesh name="link4" file="Link4.STL" />
    <mesh name="link5" file="Link5.STL" />
    <mesh name="link6" file="Link6.STL" />
    <mesh name="link7" file="Link7.STL" />
    <mesh name="stand_v2" file="stand_v2.STL" />

    <!-- Base/Lift meshes -->
    <mesh name="base_profile_short" file="base_profile_short.stl" />
    <!-- swerve: 4 steering knuckles (Part_2*) + 4 wheels (MK4_Colson_Hub_4_X_1_5*).
         Renamed from '1.5' to '1_5': a period in a mesh name becomes a period in a USD
         prim name, which SdfPath rejects and Isaac Sim refuses to import. -->
    <mesh name="Part_2" file="Part_2.stl" />
    <mesh name="MK4_Colson_Hub_4_X_1_5" file="MK4_Colson_Hub_4_X_1_5.stl" />
    <mesh name="Part_2_2" file="Part_2_2.stl" />
    <mesh name="MK4_Colson_Hub_4_X_1_5_2" file="MK4_Colson_Hub_4_X_1_5_2.stl" />
    <mesh name="Part_2_3" file="Part_2_3.stl" />
    <mesh name="MK4_Colson_Hub_4_X_1_5_3" file="MK4_Colson_Hub_4_X_1_5_3.stl" />
    <mesh name="Part_2_4" file="Part_2_4.stl" />
    <mesh name="MK4_Colson_Hub_4_X_1_5_4" file="MK4_Colson_Hub_4_X_1_5_4.stl" />
    <!-- The 4 swerve-wheel (MK4_Colson_Hub_4_X_1.5*) and 4 steering-knuckle (Part_2*)
         meshes were declared here but referenced by no geom - this model has a welded
         base with no wheels. Removed: they loaded 1.8 MB of unused geometry, and the
         "1.5" in the wheel names put a period in the mesh name, which breaks USD /
         Isaac Sim import (SdfPath disallows dots in prim names). The wheel geometry
         still lives in meshes/ and assets_nero/ for robot.mjcf. -->
    <mesh name="Lift_Middle" file="Lift_Middle.stl" />
    <mesh name="Lift_Top" file="Lift_Top.stl" />
    <!-- BEGIN AGX GRIPPER (meshes): generated by robot/yor-description/make_agx_variant.py - do not hand-edit. -->
    <mesh name="agx_gripper_base" file="gripper_base.stl"/>
    <mesh name="agx_finger_a" file="gripper_link7.stl"/>
    <mesh name="agx_finger_b" file="link8.stl"/>
    <!-- END AGX GRIPPER -->
    <!-- BEGIN HEAD (meshes): generated by output/head/build_head.py - do not hand-edit. -->
    <mesh name="head_topbase1_cut" file="head/topbase1_cut.stl"/>
    <mesh name="head_topbase2" file="head/topbase2.stl"/>
    <mesh name="head_tophead1" file="head/tophead1.stl"/>
    <mesh name="head_tophead4" file="head/tophead4.stl"/>
    <mesh name="head_tophead5" file="head/tophead5.stl"/>
    <!-- END HEAD -->
  </asset>

  <worldbody>
     <!-- Base/Lift Body Structure (Simplified copy from original) -->
    <body name="base" pos="0 0 0.104775" euler="0 1.57 0" childclass="robot">
       <freejoint name="floating_base"/>
       <geom name="base_visual" type="sphere" size="0.01" class="visual" material="base_material"/>
       <body name="base_profile_short">
          <!-- CAD inertials for the chassis and both lift stages come from robot.mjcf;
               the welded-base model omitted them and let MuJoCo infer mass from mesh
               volume, which is not the real chassis mass. -->
          <inertial pos="-0.104952 -0.210077 0.000819" mass="20.612589"
            diaginertia="0.321576 0.487585 0.4515" />
          <geom mesh="base_profile_short" class="visual" material="base_profile_short_material"/>
          <!-- type="box" (not the capsule that class="collision" defaults to): a
               rounded chassis hull makes the robot rock and topple once the base is
               free-floating. Matches robot.mjcf. -->
          <geom mesh="base_profile_short" type="box" class="collision"/>

          <body name="Part_2" pos="-0.028575 -0.053975 0.104775" quat="0.5000001633974483 -0.4999999999999733 -0.49999983660255165 0.4999999999999733">
            <joint name="front_left_steer" type="hinge" ref="0.0" class="steering_joint" axis="0 0 1" />
            <inertial pos="0.000006 0 -0.020456" quat="1.0 0.0 0.0 0.0" mass="0.671221" diaginertia="0.000668 0.000705 0.000812" />
            <geom name="Part_2_collision" pos="0 0 0" quat="1.0 0.0 0.0 0.0" type="mesh" mesh="Part_2" class="collision" />
            <geom name="Part_2_visual" pos="0 0 0" quat="1.0 0.0 0.0 0.0" material="Part_2_material" type="mesh" mesh="Part_2" class="visual" />
            <body name="MK4_Colson_Hub_4_X_1_5" pos="0.021272 0 -0.075425" quat="0.5000001633974483 -0.4999999999999733 -0.49999983660255165 0.4999999999999733">
              <joint name="drive_front_left" type="hinge" ref="0.0" class="drive_joint" axis="0 0 -1" />
              <inertial pos="0 0 0.019800" quat="1.0 0.0 0.0 0.0" mass="0.507297" diaginertia="0.000352 0.000352 0.000615" />
              <geom name="MK4_Colson_Hub_4_X_1_5_collision" pos="0 0 0" quat="1.0 0.0 0.0 0.0" type="mesh" mesh="MK4_Colson_Hub_4_X_1_5" class="wheel" />
              <geom name="MK4_Colson_Hub_4_X_1_5_visual" pos="0 0 0" quat="1.0 0.0 0.0 0.0" material="MK4_Colson_Hub_4_X_1_5_material" type="mesh" mesh="MK4_Colson_Hub_4_X_1_5" class="visual" />
            </body>
          </body>
          <body name="Part_2_2" pos="-0.028575 -0.053975 -0.104775" quat="0.5000001633974483 -0.4999999999999733 -0.49999983660255165 0.4999999999999733">
            <joint name="back_left_steer" type="hinge" ref="0.0" class="steering_joint" axis="0 0 1" />
            <inertial pos="0.000006 0 -0.020456" quat="1.0 0.0 0.0 0.0" mass="0.671221" diaginertia="0.000668 0.000705 0.000812" />
            <geom name="Part_2_2_collision" pos="0 0 0" quat="1.0 0.0 0.0 0.0" type="mesh" mesh="Part_2_2" class="collision" />
            <geom name="Part_2_2_visual" pos="0 0 0" quat="1.0 0.0 0.0 0.0" material="Part_2_material" type="mesh" mesh="Part_2_2" class="visual" />
            <body name="MK4_Colson_Hub_4_X_1_5_2" pos="0.021272 0 -0.075425" quat="0.5000001633974483 -0.4999999999999733 -0.49999983660255165 0.4999999999999733">
              <joint name="drive_back_left" type="hinge" ref="0.0" class="drive_joint" axis="0 0 -1" />
              <inertial pos="0 0 0.019800" quat="1.0 0.0 0.0 0.0" mass="0.507297" diaginertia="0.000352 0.000352 0.000615" />
              <geom name="MK4_Colson_Hub_4_X_1_5_2_collision" pos="0 0 0" quat="1.0 0.0 0.0 0.0" type="mesh" mesh="MK4_Colson_Hub_4_X_1_5_2" class="wheel" />
              <geom name="MK4_Colson_Hub_4_X_1_5_2_visual" pos="0 0 0" quat="1.0 0.0 0.0 0.0" material="MK4_Colson_Hub_4_X_1_5_material" type="mesh" mesh="MK4_Colson_Hub_4_X_1_5_2" class="visual" />
            </body>
          </body>
          <body name="Part_2_3" pos="-0.028575 -0.365125 0.104775" quat="0.5000001633974483 -0.4999999999999733 -0.49999983660255165 0.4999999999999733">
            <joint name="front_right_steer" type="hinge" ref="0.0" class="steering_joint" axis="0 0 1" />
            <inertial pos="0.000006 0 -0.020456" quat="1.0 0.0 0.0 0.0" mass="0.671221" diaginertia="0.000668 0.000705 0.000812" />
            <geom name="Part_2_3_collision" pos="0 0 0" quat="1.0 0.0 0.0 0.0" type="mesh" mesh="Part_2_3" class="collision" />
            <geom name="Part_2_3_visual" pos="0 0 0" quat="1.0 0.0 0.0 0.0" material="Part_2_material" type="mesh" mesh="Part_2_3" class="visual" />
            <body name="MK4_Colson_Hub_4_X_1_5_3" pos="0.021272 0 -0.075425" quat="0.5000001633974483 -0.4999999999999733 -0.49999983660255165 0.4999999999999733">
              <joint name="drive_front_right" type="hinge" ref="0.0" class="drive_joint" axis="0 0 -1" />
              <inertial pos="0 0 0.019800" quat="1.0 0.0 0.0 0.0" mass="0.507297" diaginertia="0.000352 0.000352 0.000615" />
              <geom name="MK4_Colson_Hub_4_X_1_5_3_collision" pos="0 0 0" quat="1.0 0.0 0.0 0.0" type="mesh" mesh="MK4_Colson_Hub_4_X_1_5_3" class="wheel" />
              <geom name="MK4_Colson_Hub_4_X_1_5_3_visual" pos="0 0 0" quat="1.0 0.0 0.0 0.0" material="MK4_Colson_Hub_4_X_1_5_material" type="mesh" mesh="MK4_Colson_Hub_4_X_1_5_3" class="visual" />
            </body>
          </body>
          <body name="Part_2_4" pos="-0.028575 -0.365125 -0.104775" quat="0.5000001633974483 -0.4999999999999733 -0.49999983660255165 0.4999999999999733">
            <joint name="back_right_steer" type="hinge" ref="0.0" class="steering_joint" axis="0 0 1" />
            <inertial pos="0.000006 0 -0.020456" quat="1.0 0.0 0.0 0.0" mass="0.671221" diaginertia="0.000668 0.000705 0.000812" />
            <geom name="Part_2_4_collision" pos="0 0 0" quat="1.0 0.0 0.0 0.0" type="mesh" mesh="Part_2_4" class="collision" />
            <geom name="Part_2_4_visual" pos="0 0 0" quat="1.0 0.0 0.0 0.0" material="Part_2_material" type="mesh" mesh="Part_2_4" class="visual" />
            <body name="MK4_Colson_Hub_4_X_1_5_4" pos="0.021272 0 -0.075425" quat="0.5000001633974483 -0.4999999999999733 -0.49999983660255165 0.4999999999999733">
              <joint name="drive_back_right" type="hinge" ref="0.0" class="drive_joint" axis="0 0 -1" />
              <inertial pos="0 0 0.019800" quat="1.0 0.0 0.0 0.0" mass="0.507297" diaginertia="0.000352 0.000352 0.000615" />
              <geom name="MK4_Colson_Hub_4_X_1_5_4_collision" pos="0 0 0" quat="1.0 0.0 0.0 0.0" type="mesh" mesh="MK4_Colson_Hub_4_X_1_5_4" class="wheel" />
              <geom name="MK4_Colson_Hub_4_X_1_5_4_visual" pos="0 0 0" quat="1.0 0.0 0.0 0.0" material="MK4_Colson_Hub_4_X_1_5_material" type="mesh" mesh="MK4_Colson_Hub_4_X_1_5_4" class="visual" />
            </body>
          </body>

          
          <body name="Lift_Middle" pos="-0.5094 -0.20955 0.0003" quat="0 -0.707107 0 0.707107">
             <inertial pos="0 0 -0.104" mass="1.460741" diaginertia="0.007792 0.007792 0.005051" />
             <joint name="lift_joint" class="telescope"/>
             <geom mesh="Lift_Middle" class="visual" material="Lift_Middle_material"/>
             <geom mesh="Lift_Middle" type="mesh" class="collision"/>
             
             <body name="Lift_Top" pos="0 0 0">
               <inertial pos="0.000005 -0.000004 -0.024234" mass="4.43511"
                 diaginertia="0.042873 0.040894 0.045651" />
               <geom mesh="Lift_Top" class="visual" material="Lift_Middle_material"/>
               <geom mesh="Lift_Top" type="mesh" class="collision"/>

               <!-- Left Arm (7 DOF) - Nero structure with quaternions -->
                <body name="left_arm_base_link" pos="-0.005 -0.125 0.0575" euler="1.5708 0 0" childclass="nero" gravcomp="0">
                  <inertial pos="-0.00963615 0.00016787 0.0448601" mass="0.77" diaginertia="0.0006669 0.00054501 0.00051509" />
                  <geom mesh="base_link" class="visual" material="light_medium_gray_mat"/>
                  <geom mesh="base_link" class="collision"/>
                  
                  <body name="left_arm_link1" pos="0 0 0.138" quat="1.0 0.0 0.0 0.0" gravcomp="0">
                    <inertial pos="-0.00077 -0.00006 -0.00686" mass="0.77" diaginertia="0.0006669 0.00054501 0.00051509" />
                    <joint name="left_arm_joint1" axis="0 0 1" range="-2.705261 2.705261"/>
                    <geom mesh="link1" class="visual" material="gray_mat"/>
                    <geom mesh="link1" class="collision"/>
                    
                    <body name="left_arm_link2" pos="0 0 0" quat="0.000033 0.000033 0.707105 -0.707108" gravcomp="0">
                      <inertial pos="-0.00011 -0.06072 0.00148" mass="0.49" diaginertia="0.00053808 0.00029435 0.00040266" />
                      <joint name="left_arm_joint2" axis="0 0 1" range="-1.745330 1.745330"/>
                      <geom mesh="link2" class="visual" material="light_medium_gray_mat"/>
                      <geom mesh="link2" class="collision"/>
                      
                      <body name="left_arm_link3" pos="0 -0.31 0" quat="-0.000003 0.000003 -0.707108 0.707105" gravcomp="0">
                        <inertial pos="0.00014 0.00211 -0.04853" mass="0.67" diaginertia="0.00342528 0.0033924 0.00026169" />
                        <joint name="left_arm_joint3" axis="0 0 1" range="-2.757621 2.757621"/>
                        <geom mesh="link3" class="visual" material="gray_mat"/>
                        <geom mesh="link3" class="collision"/>
                        
                        <body name="left_arm_link4" pos="0 0 0" quat="-0.000003 0.000003 -0.707108 0.707105" gravcomp="0">
                          <inertial pos="-0.00013 -0.05482 0.00132" mass="0.41" diaginertia="0.00031331 0.00013204 0.0002393" />
                          <joint name="left_arm_joint4" axis="0 0 1" range="-1.012291 2.146755"/>
                          <geom mesh="link4" class="visual" material="light_medium_gray_mat"/>
                          <geom mesh="link4" class="collision"/>
                          
                          <body name="left_arm_link5" pos="0 -0.27001 0" quat="0.499998 0.500000 -0.500000 0.500002" gravcomp="0">
                            <inertial pos="0.00303 0.00617 -0.11778" mass="0.56" diaginertia="0.0008249 0.00078548 0.00021015" />
                            <joint name="left_arm_joint5" axis="0 0 1" range="-2.757621 2.757621"/>
                            <geom mesh="link5" class="visual" material="gray_mat"/>
                            <geom mesh="link5" class="collision"/>
                            
                            <body name="left_arm_link6" pos="0 0 0" quat="0.499998 0.500000 -0.500000 0.500002" gravcomp="0">
                              <inertial pos="0.00014 -0.0027 -0.00025" mass="0.31" diaginertia="0.00008181 0.00007176 0.00007906" />
                              <joint name="left_arm_joint6" axis="0 0 1" range="-0.733039 0.959932"/>
                              <geom mesh="link6" class="visual" material="light_medium_gray_mat"/>
                              <geom mesh="link6" class="collision"/>
                              
                              <body name="left_arm_link7" pos="0 -0.0235 0" euler="1.5708 0 -1.5708" gravcomp="0">
                                <inertial pos="-0.00014 -0.0001 -0.00275" mass="0.000001" diaginertia="1.1e-07 1.1e-07 2e-07" />
                                <joint name="left_arm_joint7" axis="0 0 1" range="-1.570797 1.570797"/>
                                <geom mesh="link7" class="visual" material="gray_mat"/>
                                <geom mesh="link7" class="collision"/>
                                
                                <!-- End Effector with stand_v2 -->
                                <body name="left_arm_end_effector" pos="0 0.033 -0.0235" gravcomp="0">
                                  <inertial pos="-0.01208 -0.00025 0.00032" mass="0.05" diaginertia="2.697e-05 4.311e-05 2.479e-05" />
                                  <geom mesh="stand_v2" euler="-1.57 0 -1.57" class="visual" material="gray_mat"/>
                                  <geom mesh="stand_v2" euler="-1.57 0 -1.57" class="collision"/>
                                  <site name="left_arm_ee" pos="0 0 0.0"/>
                                  <!-- BEGIN AGX GRIPPER (left gripper): generated by robot/yor-description/make_agx_variant.py - do not hand-edit. -->
                                  <body name="left_gripper_base" childclass="agx_gripper" pos="0 0.012 0" quat="0.707107 -0.707107 0 0">
                                    <inertial pos="-0.000183807 8.05033e-05 0.0321437" quat="0.999976 9.08444e-05 0.00689649 0.000788512" mass="0.45" diaginertia="0.000929442 0.000714469 0.000394318"/>
                                    <geom class="agx_gripper_visual" mesh="agx_gripper_base"/>
                                    <geom class="agx_gripper_collision" type="mesh" mesh="agx_gripper_base"/>
                                    <site name="left_gripper_center" pos="0 0 0.12"/>
                                    <body name="left_gripper_finger_a" pos="0 0 0.1358" quat="0.707105 0.707108 0 0">
                                      <inertial pos="0.000651232 -0.049193 0.00972259" quat="0.477798 0.572974 -0.518028 0.418398" mass="0.025" diaginertia="7.74531e-05 7.36783e-05 5.0886e-06"/>
