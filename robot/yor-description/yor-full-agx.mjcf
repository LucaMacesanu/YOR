               <body name="head_neck" pos="-0.044 0 0.11247" childclass="head">
                 <inertial pos="0.0365584 -2.83082e-05 0.164128" mass="0.0798987" fullinertia="0.000267403 0.000276796 2.70898e-05 2.02263e-07 -2.13397e-05 1.75885e-06"/>
